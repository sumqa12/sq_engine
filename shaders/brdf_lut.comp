#version 450

// BRDF LUT（phase16 ②-7）。環境マップに依存しない固定の表。
//   x 軸 = NdotV [0,1]、y 軸 = roughness [0,1]
//   出力 rg = (scale, bias)。triangle.frag で specular = prefiltered * (F0 * scale + bias)
//
// ディスパッチ: vkCmdDispatch(512 / 8, 512 / 8, 1)   ★ z = 1（キューブではない）
// ★ このファイルを足したら CMake を再実行すること（*.comp の GLOB）。

#define PI 3.14159265359

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ★ binding=0（入力）は**宣言しない**。レイアウトは前計算で共用（binding=0 / 1）だが、
//   シェーダが使わない binding は未更新でもよい（静的に使用されないため）。
// ★ 書式は rg16f（C++ 側 kBrdfLutFormat = R16G16_SFLOAT と一致）。
//   拡張ストレージ書式なので、デバイス機能 shaderStorageImageExtendedFormats を
//   **有効化してから**このシェーダのパイプラインを作ること（device.cpp）。
//   有効化前に作ると vkCreateComputePipelines でバリデーションエラーになる。
// ★ imageStore には vec4 を渡す（rg16f でも引数は vec4。b / a は捨てられる）。
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D out_lut;

const uint kSampleCount = 1024u;

// prefilter.comp と同じ3関数（コピーするなら片方だけ直す事故に注意。irradiance.comp の注記）。
float radical_inverse_vdc(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;   // / 0x100000000
}
vec2 hammersley(uint i, uint n) {
    return vec2(float(i) / float(n), radical_inverse_vdc(i));
}
vec3 importance_sample_ggx(vec2 Xi, vec3 N, float roughness) {
    float a = roughness * roughness;
    float phi       = 2.0 * PI * Xi.x;
    float cos_theta = sqrt((1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y));
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);
    vec3 H = vec3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);   // 接空間

    //   接空間 -> ワールド（irradiance.comp と同じ up / right の作り方）
    vec3 up        = abs(N.y) < 0.999 ? vec3(0, 1, 0) : vec3(0, 0, 1);
    vec3 tangent   = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

// Smith / Schlick-GGX の G1。
// ★ IBL では k = roughness² / 2。直接照明（triangle.frag の G_Smith）の k = (roughness + 1)² / 8 とは**別の式**。
//   phase15 の G_Smith をそのまま持ってくると、粗い面の鏡面反射が暗くなりすぎる（②-7 / ②-10）。
float g_schlick_ggx_ibl(float NdotX, float roughness) {
    float k = (roughness * roughness) / 2.0;
    return NdotX / (NdotX * (1.0 - k) + k);
}

void main() {
    ivec2 size = imageSize(out_lut);
    if (gl_GlobalInvocationID.x >= size.x || gl_GlobalInvocationID.y >= size.y) return;

    float NdotV     = (float(gl_GlobalInvocationID.x) + 0.5) / float(size.x);
    float roughness = (float(gl_GlobalInvocationID.y) + 0.5) / float(size.y);
    //     ★ + 0.5 でテクセル中心を取る。NdotV = 0 ちょうどを避ける意味もある（V が面に沿うと割り算が壊れる）

    vec3 V = vec3(sqrt(1.0 - NdotV * NdotV), 0.0, NdotV);
    vec3 N = vec3(0, 0, 1);
    float A = 0.0;
    float B = 0.0;
    for (uint i = 0u; i < kSampleCount; ++i) {
        vec3 H = importance_sample_ggx(hammersley(i, kSampleCount), N, roughness);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = max(L.z, 0.0);
        float NdotH = max(H.z, 0.0);
        float VdotH = max(dot(V, H), 0.0);
        if (NdotL > 0.0) {
            float G     = g_schlick_ggx_ibl(NdotV, roughness) * g_schlick_ggx_ibl(NdotL, roughness);
            float G_vis = (G * VdotH) / (NdotH * NdotV);
            float Fc    = pow(1.0 - VdotH, 5.0);
            A += (1.0 - Fc) * G_vis;
            B += Fc * G_vis;
        }
    }
    imageStore(out_lut, ivec2(gl_GlobalInvocationID.xy), vec4(A / kSampleCount, B / kSampleCount, 0.0, 1.0));
    // ★ 値の目安（RenderDoc 等で LUT を覗けるなら）:
    //   NdotV ≈ 1, roughness ≈ 0（真正面・鏡面） → scale ≈ 1, bias ≈ 0
    //   NdotV ≈ 0（かすめる角度）               → bias が大きくなる（フレネルで縁が光る）
    //   どの値も [0, 1] に収まる。1 を超えるなら G_vis の式か k の取り違え。
    // ★ triangle.frag は texture(brdf_lut, vec2(NdotV, roughness)) で読む。
    //   ここで x = NdotV / y = roughness にしているので、引数の順を入れ替えないこと。
}
